{
  "manifest_version": 3,
  "name": "知乎推荐页净化",
  "version": "1.1.1",
  "description": "净化知乎首页推荐，并隐藏热榜、专栏、圈子等导航和侧栏入口。",
  "content_scripts": [
    {
      "matches": ["https://www.zhihu.com/*"],
      "js": ["rules.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
